  <!-- JAVASCRIPT PARA INTERACTIVIDAD, LIGHTBOX Y CARGA DE IMÁGENES -->
  <script>
    // 1. Desplegar / plegar el prompt original
    function togglePromptBox() {
      const content = document.getElementById('promptContent');
      const chevron = document.getElementById('promptChevron');
      content.classList.toggle('hidden');
      chevron.classList.toggle('rotate-180');
    }

    // 2. Ampliar cualquier captura o mockup en el modal Lightbox
    function openLightbox(elementId, title) {
      const sourceEl = document.getElementById(elementId);
      if (!sourceEl) return;

      const modal = document.getElementById('lightboxModal');
      const modalTitle = document.getElementById('lightboxTitle');
      const modalBody = document.getElementById('lightboxBody');

      modalTitle.textContent = title;
      modalBody.innerHTML = '';

      const clone = sourceEl.cloneNode(true);
      clone.removeAttribute('id');
      clone.removeAttribute('onclick');
      clone.classList.remove('mockup-frame');
      clone.classList.add('w-full', 'max-w-3xl', 'shadow-xl');

      modalBody.appendChild(clone);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeLightbox() {
      const modal = document.getElementById('lightboxModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // Cerrar modal con tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    // 3. Permitir sustituir un mockup por la captura PNG/JPG local si el alumno lo desea
    function replaceMockupWithImage(event, targetId) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const container = document.getElementById(targetId);
        if (container) {
          container.innerHTML = `<img src="${e.target.result}" alt="Captura de pantalla FokusMove" class="w-full h-auto object-contain block" />`;
        }
      };
      reader.readAsDataURL(file);
    }

    // 4. Animación suave al hacer scroll (IntersectionObserver)
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    });
  </script>
