    function toggleRockyMusic() {
      const icon = document.getElementById('musicPlayIcon');
      const visualizer = document.getElementById('musicBeatVisualizer');
      
      if (state.musicPlaying) {
        clearInterval(state.musicInterval);
        state.musicPlaying = false;
        icon.className = 'fa-solid fa-play text-xs';
        visualizer.textContent = '♫ ♪';
      } else {
        state.musicPlaying = true;
        icon.className = 'fa-solid fa-pause text-xs';
        playMusicLoop();
      }
    }

    function playMusicLoop() {
      const track = trackThemes[state.currentTrack] || trackThemes.eye;
      let noteIndex = 0;
      const visualizerNotes = ['♫', '♬', '♩', '♪', '⚡'];

      state.musicInterval = setInterval(() => {
        if (!state.musicPlaying) return;
        const ctx = getAudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        
        const freq = track.notes[noteIndex % track.notes.length];
        noteIndex++;

        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        
        const filter = ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(1000, ctx.currentTime);

        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.18);

        osc.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);

        osc.start();
        osc.stop(ctx.currentTime + 0.2);

        const randomIcon = visualizerNotes[Math.floor(Math.random() * visualizerNotes.length)];
        document.getElementById('musicBeatVisualizer').textContent = `${randomIcon} ${randomIcon}`;
      }, track.tempo);
    }

    function changeTrack(key) {
