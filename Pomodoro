<!DOCTYPE html>

<html lang="es"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>FokusMove — Cronógrafo Pomodoro &amp; Fitness de Lujo</title>
<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Google Fonts: Cormorant Garamond & Montserrat -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&amp;family=Montserrat:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
<!-- FontAwesome Icons -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
<script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Montserrat"', 'system-ui', 'sans-serif'],
          },
          colors: {
            rolex: {
              gold: '#C5A059',
              goldLight: '#E8D39A',
              goldDark: '#8F6F2C',
              iceBlue: '#DCE8F5',
              iceBlueDark: '#B8D2EB',
              iceBlueLight: '#F0F6FC',
              steel: '#8E9DAE',
              steelDark: '#4A5B6E',
              midnight: '#0C131F',
              slateDeep: '#161F30'
            }
          }
        }
      }
    }
  </script>
<style>
    /* Efecto Bisel Acanalado (Fluted Bezel) Rolex con reflejos de metales preciosos */
    .rolex-bezel {
      background: repeating-conic-gradient(
        from 0deg,
        #f4eedb 0deg 3.75deg,
        #cfb57a 3.75deg 7.5deg,
        #8f7034 7.5deg 11.25deg,
        #cfb57a 11.25deg 15deg
      );
      box-shadow: 
        0 18px 45px -8px rgba(12, 19, 31, 0.45),
        0 0 0 1px rgba(255, 255, 255, 0.6) inset,
        0 2px 10px rgba(0, 0, 0, 0.35);
    }

    .rolex-steel-bezel {
      background: repeating-conic-gradient(
        from 0deg,
        #ffffff 0deg 3.75deg,
        #cbd5e1 3.75deg 7.5deg,
        #64748b 7.5deg 11.25deg,
        #cbd5e1 11.25deg 15deg
      );
    }

    /* Esfera Satinada Radial Ice Blue */
    .ice-blue-sunburst {
      background: radial-gradient(circle at 50% 45%, #F4F9FF 0%, #DCE8F5 45%, #BBD5EE 85%, #9EBFDE 100%);
      box-shadow: inset 0 0 35px rgba(58, 97, 138, 0.28), inset 0 2px 6px rgba(255, 255, 255, 0.85);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.82);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow: 0 10px 30px -5px rgba(20, 38, 64, 0.08);
    }

    .dark-card {
      background: linear-gradient(145deg, rgba(23, 37, 60, 0.94), rgba(16, 27, 46, 0.96));
      border: 1px solid rgba(197, 160, 89, 0.3);
      box-shadow: 0 15px 35px -5px rgba(8, 16, 30, 0.45);
    }

    /* Anillo del cronómetro de progreso */
    .progress-ring__circle {
      transition: stroke-dashoffset 0.35s ease;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }

    /* Animación sutil de pulso */
    @keyframes subtlePulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.92; transform: scale(1.008); }
    }
    .ticking-glow {
      animation: subtlePulse 2s infinite ease-in-out;
    }

    /* Lente Cíclope con reflejo Rolex auténtico a las 3 en punto */
    .cyclops-lens {
      background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(240,244,248,0.85) 100%);
      box-shadow: 
        0 4px 10px rgba(0,0,0,0.3),
        inset 0 1px 2px rgba(255,255,255,1),
        inset 0 -1px 2px rgba(0,0,0,0.25),
        0 0 0 1.5px rgba(197, 160, 89, 0.85);
      border-radius: 4px;
    }

    /* Transición suave para cambio de tema */
    body {
      transition: background 0.6s cubic-bezier(0.4, 0, 0.2, 1), color 0.4s ease;
    }

    /* Fondos Temáticos Rolex más claros, luminosos y elegantes */
    .theme-iceblue {
      background: radial-gradient(circle at 50% 25%, #2B456E 0%, #1D3150 48%, #14233A 100%);
    }
    .theme-hulk {
      background: radial-gradient(circle at 50% 25%, #184A32 0%, #103623 48%, #0B2519 100%);
    }
    .theme-pepsi {
      background: radial-gradient(circle at 20% 30%, #3B1F34 0%, #1E2D4E 48%, #131E35 100%);
    }
    .theme-panda {
      background: radial-gradient(circle at 50% 25%, #3C444D 0%, #2A3138 48%, #1B2127 100%);
    }
    .theme-everose {
      background: radial-gradient(circle at 50% 25%, #4C2B2D 0%, #331C1E 48%, #211213 100%);
    }

    /* Contenedor de controles plegables de la barra superior */
    #headerExtraControls {
      transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease, transform 0.35s ease;
      will-change: max-height, opacity, transform;
    }

    #headerExtraControls.collapsed {
      max-height: 0px !important;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      overflow: hidden;
    }

    #headerExtraControls:not(.collapsed) {
      max-height: 140px;
      opacity: 1;
      transform: translateY(0);
      overflow: visible;
    }

    /* Scrollbar personalizada */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(216, 230, 243, 0.1);
    }
    ::-webkit-scrollbar-thumb {
      background: #c5a059;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="theme-iceblue min-h-screen text-slate-800 font-sans antialiased selection:bg-rolex-gold selection:text-white pb-12 transition-colors duration-700" id="appBody">
<!-- BARRA SUPERIOR DE ALTA RELOJERÍA PLEGABLE / DESPLEGABLE -->
<header class="border-b border-rolex-gold/30 bg-[#0F1A2A]/90 backdrop-blur-md sticky top-0 z-40 px-4 sm:px-6 py-2.5 transition-all duration-300 shadow-md">
<div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-2.5">
<!-- Marca & Emblema (BOTÓN INTERACTIVO PARA PLEGAR/DESPLEGAR) -->
<div class="flex items-center justify-between">
<button class="flex items-center space-x-3 group text-left cursor-pointer focus:outline-none select-none rounded-xl p-1 -m-1 transition-all hover:opacity-95" id="brandHeaderToggle" onclick="toggleHeaderNav()" title="Plegar / Desplegar barra de controles">
<div class="w-9 h-9 rounded-full bg-gradient-to-br from-rolex-goldLight to-rolex-goldDark flex items-center justify-center shadow-lg shadow-rolex-gold/25 text-slate-950 font-serif font-bold text-lg border border-yellow-200 group-hover:scale-105 transition-transform">
<i class="fa-solid fa-crown text-sm"></i>
</div>
<div>
<div class="flex items-center gap-2">
<span class="font-serif text-2xl tracking-widest text-rolex-gold font-bold uppercase drop-shadow-sm group-hover:text-yellow-300 transition-colors">FokusMove</span>
<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-slate-800/80 border border-rolex-gold/40 text-rolex-gold text-[10px] transition-transform duration-300 group-hover:border-rolex-gold" id="headerChevron">
<i class="fa-solid fa-chevron-up transition-transform duration-300" id="headerChevronIcon"></i>
</span>
</div>
<span class="text-[10px] block font-sans tracking-widest text-slate-300 uppercase -mt-1 font-semibold group-hover:text-slate-200 transition-colors" id="editionHeaderTag">Cronógrafo Pomodoro &amp; Fitness • Edición Platino</span>
</div>
</button>
</div>
<!-- CONTROLES SECUNDARIOS PLEGABLES (Fecha/Hora, Selector Tema, Sonido Tictac, Ajustes) -->
<div class="flex flex-wrap items-center justify-between md:justify-end gap-3 w-full md:w-auto" id="headerExtraControls">
<!-- Complicación de Fecha y Hora en Tiempo Real (Reloj Suizo en Vivo) -->
<div class="flex items-center space-x-2 bg-slate-900/90 border border-rolex-gold/30 rounded-full px-4 sm:px-5 py-1.5 shadow-inner">
<i class="fa-regular fa-clock text-rolex-gold text-xs"></i>
<!-- Ventanilla del Día (Rolex Day Aperture) -->
<span class="text-rolex-gold font-serif text-xs font-semibold tracking-wider uppercase border-r border-slate-700 pr-3" id="liveDayName">LUNES</span>
<!-- Ventanilla de Fecha -->
<span class="text-slate-300 text-xs font-medium border-r border-slate-700 pr-3" id="liveFullDate">18 de Mayo, 2025</span>
<!-- Hora HH:MM:SS en vivo -->
<span class="text-yellow-100 font-mono text-xs font-bold tracking-widest" id="liveTime">12:00:00</span>
</div>
<!-- Audio, Selector de Modelo Rolex & Ajustes -->
<div class="flex items-center space-x-2.5 sm:space-x-3 flex-wrap">
<!-- SELECTOR DE MODELOS / TEMAS ROLEX -->
<div class="relative inline-flex items-center">
<i class="fa-solid fa-gem text-rolex-gold text-xs absolute left-3 pointer-events-none"></i>
<select class="appearance-none text-xs pl-8 pr-7 py-1.5 rounded-full border border-rolex-gold/50 bg-slate-900 text-rolex-gold font-serif tracking-wider font-semibold focus:outline-none focus:ring-1 focus:ring-rolex-gold cursor-pointer shadow-md" id="themeSelector" onchange="changeRolexTheme(this.value)">
<option value="iceblue">Day-Date Platino Ice Blue</option>
<option value="hulk">Submariner Hulk / Kermit</option>
<option value="pepsi">GMT-Master II Pepsi</option>
<option value="panda">Daytona Panda Monocromo</option>
<option value="everose">Daytona Oro Everose / Choco</option>
</select>
<i class="fa-solid fa-chevron-down text-[10px] text-rolex-gold absolute right-3 pointer-events-none"></i>
</div>
<button class="text-xs px-3 py-1.5 rounded-full border border-slate-700 bg-slate-800 text-slate-300 hover:text-rolex-gold hover:border-rolex-gold transition flex items-center gap-1.5" id="toggleTickingSoundBtn" title="Sonido Mecánico de Tictac">
<i class="fa-solid fa-volume-high text-rolex-gold" id="soundIcon"></i>
<span id="soundLabel">Tictac: ON</span>
</button>
<button class="text-xs px-3 py-1.5 rounded-full border border-rolex-gold/40 bg-rolex-gold/10 text-rolex-gold hover:bg-rolex-gold hover:text-slate-900 transition font-medium flex items-center gap-1.5" onclick="document.getElementById('configModal').classList.remove('hidden')">
<i class="fa-solid fa-sliders"></i>
<span>Ajustes</span>
</button>
</div>
</div>
</div>
</header>
<!-- BOTÓN FLOTANTE DISCRETO PARA ALTERNAR PANELES EN MODO ENFOQUE -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 pt-3 flex justify-end">
<button class="text-xs px-3.5 py-1.5 rounded-full border border-rolex-gold/40 bg-slate-900/90 text-slate-200 hover:text-rolex-gold hover:border-rolex-gold transition shadow-md flex items-center gap-2" id="togglePanelsBtn" onclick="toggleContextPanelsManual()">
<i class="fa-solid fa-eye-slash text-rolex-gold text-xs" id="togglePanelsIcon"></i>
<span id="togglePanelsText">Ocultar Agenda &amp; Fitness</span>
</button>
</div>
<!-- CONTENEDOR PRINCIPAL EN RETÍCULA -->
<main class="max-w-7xl mx-auto px-4 sm:px-6 pt-2 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start transition-all duration-500">
<!-- COLUMNA PRINCIPAL: TEMPORIZADOR CRONÓGRAFO ROLEX DAY-DATE -->
<section class="lg:col-span-7 flex flex-col items-center transition-all duration-500" id="timerColumn">
<!-- Selector de Modos (Enfoque, Descanso Corto, Descanso Largo) -->
<div class="flex items-center justify-center gap-2 p-1.5 rounded-full bg-slate-900/80 border border-slate-700/80 shadow-xl mb-6 backdrop-blur w-full max-w-md">
<button class="flex-1 py-2 px-3 rounded-full text-xs font-semibold tracking-wider transition-all duration-300 bg-gradient-to-r from-rolex-gold to-yellow-600 text-slate-950 shadow-md" id="btnModeWork" onclick="setTimerMode('work')">
<i class="fa-solid fa-brain mr-1"></i> ENFOQUE
        </button>
<button class="flex-1 py-2 px-3 rounded-full text-xs font-semibold tracking-wider text-slate-300 hover:text-white transition-all duration-300" id="btnModeShort" onclick="setTimerMode('short')">
<i class="fa-solid fa-dumbbell mr-1"></i> DESCANSO CORTO
        </button>
<button class="flex-1 py-2 px-3 rounded-full text-xs font-semibold tracking-wider text-slate-300 hover:text-white transition-all duration-300" id="btnModeLong" onclick="setTimerMode('long')">
<i class="fa-solid fa-spa mr-1"></i> DESCANSO LARGO
        </button>
</div>
<!-- RELOJ ROLEX DAY-DATE: CAJA & BISEL ACANALADO -->
<div class="relative w-[340px] sm:w-[410px] h-[340px] sm:h-[410px] rounded-full p-3.5 sm:p-4 rolex-bezel flex items-center justify-center transition-transform hover:scale-[1.01] duration-500" id="chronoBezelWrapper">
<!-- Anillo metálico pulido interior de platino -->
<div class="w-full h-full rounded-full p-2.5 bg-gradient-to-b from-slate-200 via-slate-400 to-slate-300 shadow-2xl flex items-center justify-center border border-white/60" id="bezelInnerRing">
<!-- ESFERA ICE BLUE (Sunburst Satinada) -->
<div class="relative w-full h-full rounded-full ice-blue-sunburst flex flex-col items-center justify-between p-6 sm:p-7 overflow-hidden text-slate-800" id="dialSunburstFace">
<!-- Marcadores de horas tipo bastón de platino con lumen & COMPLICACIÓN CÍCLOPE A LAS 3H -->
<div class="absolute inset-0 pointer-events-none">
<!-- Marcador 12h: Corona Rolex -->
<div class="absolute top-2.5 left-1/2 -translate-x-1/2 text-rolex-goldDark opacity-90 text-sm">
<i class="fa-solid fa-crown"></i>
</div>
<!-- COMPLICACIÓN DE FECHA ROLEX CON LUPA CÍCLOPE A LAS 3 EN PUNTO (3H) -->
<div class="absolute top-1/2 right-2 sm:right-3 -translate-y-1/2 z-20 flex items-center">
<div class="cyclops-lens w-8 h-6 sm:w-9 sm:h-7 flex items-center justify-center border border-rolex-gold shadow-md">
<span class="font-serif font-black text-slate-900 text-xs sm:text-sm tracking-tight leading-none" id="dialDateNumber">
                    15
                  </span>
</div>
</div>
<!-- Marcador 6h -->
<div class="absolute bottom-2.5 left-1/2 -translate-x-1/2 w-1.5 h-4 bg-slate-100 rounded-sm shadow-sm border border-slate-400/50"></div>
<!-- Marcador 9h -->
<div class="absolute top-1/2 left-2.5 -translate-y-1/2 w-4 h-1.5 bg-slate-100 rounded-sm shadow-sm border border-slate-400/50"></div>
</div>
<!-- SVG Ring de Progreso Circular -->
<svg class="absolute inset-0 w-full h-full pointer-events-none" viewbox="0 0 360 360">
<!-- Fondo del anillo -->
<circle cx="180" cy="180" fill="none" r="158" stroke="rgba(142, 178, 214, 0.3)" stroke-width="4"></circle>
<!-- Trazo de progreso activo -->
<circle class="progress-ring__circle" cx="180" cy="180" fill="none" id="timerProgressCircle" r="158" stroke="#C5A059" stroke-dasharray="992" stroke-dashoffset="0" stroke-linecap="round" stroke-width="6"></circle>
</svg>
<!-- SECCIÓN SUPERIOR DE LA ESFERA: Ventanilla Arqueada del Día (Rolex Day Window) -->
<div class="relative z-10 pt-1 text-center w-full">
<div class="inline-block bg-[#F8FBFE]/90 border border-slate-300/80 px-4 py-0.5 rounded shadow-inner">
<span class="font-serif font-bold text-slate-800 text-[11px] sm:text-xs tracking-[0.2em] uppercase" id="dialDayWindow">
                  MIÉRCOLES
                </span>
</div>
<h1 class="font-serif font-bold text-xl sm:text-2xl text-slate-900 tracking-wider mt-1 drop-shadow-sm uppercase" id="dialBrandTitle">FokusMove</h1>
<p class="text-[9px] tracking-[0.25em] text-slate-600 uppercase font-semibold">SUPERLATIVE CHRONOMETER</p>
</div>
<!-- SECCIÓN CENTRAL DE LA ESFERA: MINUTERO Y SEGUNDERO DIGITAL -->
<div class="relative z-10 text-center my-auto flex flex-col items-center">
<div class="font-mono text-5xl sm:text-6xl font-bold tracking-tight text-slate-900 drop-shadow-md select-none" id="dialTimerDisplay">
                25:00
              </div>
<div class="flex items-center gap-2 mt-1">
<span class="text-[10px] tracking-widest font-semibold px-2.5 py-0.5 rounded-full bg-slate-900 text-rolex-gold border border-rolex-gold/40 uppercase shadow-sm" id="currentStatusBadge">
                  SESIÓN ACTIVA
                </span>
<span class="text-[10px] text-slate-500 font-mono tracking-wider font-medium" id="cycleCountDisplay">Ciclo #1</span>
</div>
</div>
<!-- SECCIÓN INFERIOR DE LA ESFERA: Lupa Cyclops (Complicación de Sesiones) & Swiss Made -->
<div class="relative z-10 pb-1 text-center w-full">
<!-- Complicación estilo cíclope para las rondas completadas -->
<div class="inline-flex items-center gap-1.5 bg-white/70 border border-slate-300/70 px-3 py-1 rounded-full text-slate-700 shadow-sm text-xs">
<i class="fa-solid fa-fire text-amber-500"></i>
<span class="text-[10px] font-medium">Meta Diaria:</span>
<span class="font-bold text-slate-900" id="pomodoroGoalProgress">0 / 4</span>
</div>
<div class="text-[8px] tracking-[0.3em] text-slate-500 uppercase mt-1 font-semibold">
                SWISS MADE • ALTA PRODUCTIVIDAD
              </div>
</div>
</div>
</div>
</div>
<!-- BOTONES DE CONTROL MAESTRO (Corona / Pulsadores de Cronógrafo) -->
<div class="flex items-center justify-center gap-4 mt-6 w-full max-w-sm">
<!-- Pulsador Reset / Reiniciar -->
<button class="w-12 h-12 rounded-full bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-700 shadow-lg flex items-center justify-center transition active:scale-95 group" id="btnReset" onclick="resetTimer()" title="Reiniciar temporizador">
<i class="fa-solid fa-arrow-rotate-left group-hover:-rotate-90 transition-transform"></i>
</button>
<!-- Pulsador Principal (Iniciar / Pausar) -->
<button class="flex-1 py-3.5 px-6 rounded-full bg-gradient-to-r from-rolex-gold via-yellow-500 to-rolex-goldDark text-slate-950 font-bold text-sm tracking-wider uppercase shadow-xl hover:shadow-rolex-gold/30 hover:brightness-105 active:scale-98 transition flex items-center justify-center gap-2 border border-yellow-200" id="btnToggleTimer" onclick="toggleTimer()">
<i class="fa-solid fa-play text-xs" id="btnIconPlayPause"></i>
<span id="btnTextPlayPause">INICIAR ENFOQUE</span>
</button>
<!-- Pulsador Omitir / Siguiente Fase -->
<button class="w-12 h-12 rounded-full bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-rolex-gold border border-slate-700 shadow-lg flex items-center justify-center transition active:scale-95" id="btnSkip" onclick="skipToNextPhase()" title="Pasar a siguiente fase">
<i class="fa-solid fa-forward-step"></i>
</button>
</div>
<!-- RESUMEN EN VIVO DE IMPACTO EN PRODUCTIVIDAD -->
<div class="grid grid-cols-3 gap-3 w-full max-w-lg mt-6">
<div class="dark-card p-3 rounded-xl text-center">
<span class="block text-[10px] tracking-wider uppercase text-slate-300 font-medium">Sesiones Hoy</span>
<span class="font-mono text-xl font-bold text-rolex-gold" id="statSessionsToday">0</span>
</div>
<div class="dark-card p-3 rounded-xl text-center">
<span class="block text-[10px] tracking-wider uppercase text-slate-300 font-medium">Minutos Foco</span>
<span class="font-mono text-xl font-bold text-yellow-100" id="statMinutesFocused">0 min</span>
</div>
<div class="dark-card p-3 rounded-xl text-center">
<span class="block text-[10px] tracking-wider uppercase text-slate-300 font-medium">Racha Actual</span>
<span class="font-mono text-xl font-bold text-amber-400" id="statStreakDays">1 Día</span>
</div>
</div>
</section>
<!-- COLUMNA DERECHA: FITNESS ADAPTATIVO & AGENDA (CONTEXTUAL / CONDICIONAL) -->
<section class="lg:col-span-5 flex flex-col gap-6 transition-all duration-500" id="contextPanelsColumn">
<!-- MÓDULO FITNESS DEL DÍA (Detecta el día de la semana y rota automáticamente) -->
<div class="dark-card rounded-2xl p-5 border border-rolex-gold/30 shadow-2xl relative overflow-hidden">
<!-- Resplandor decorativo -->
<div class="absolute -right-12 -top-12 w-32 h-32 bg-rolex-gold/15 rounded-full blur-2xl pointer-events-none"></div>
<div class="flex items-center justify-between border-b border-slate-700/60 pb-3 mb-4">
<div class="flex items-center gap-2">
<span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
<h3 class="font-serif text-lg font-bold text-rolex-gold tracking-wide">RUTINA FITNESS PARA EL DESCANSO</h3>
</div>
<span class="text-[11px] font-mono font-semibold uppercase px-2.5 py-0.5 rounded-full bg-rolex-gold/15 text-rolex-gold border border-rolex-gold/30" id="fitnessDayTag">
            DÍA
          </span>
</div>
<!-- Músculo Objetivo & Detalles del Ejercicio -->
<div class="flex flex-col sm:flex-row gap-4 items-center mb-4">
<!-- Ilustración / Diagrama Visual SVG Técnico del Ejercicio -->
<div class="w-full sm:w-36 h-36 rounded-xl bg-slate-900 border border-slate-700 flex flex-col items-center justify-center p-2 text-center text-rolex-gold flex-shrink-0 shadow-inner relative overflow-hidden" id="exerciseSvgContainer">
<!-- El icono o diagrama se actualiza mediante JavaScript según el día -->
</div>
<div class="flex-1 w-full">
<span class="text-[10px] tracking-widest text-slate-400 uppercase font-semibold block">Músculo Principal</span>
<h4 class="text-xl font-bold text-white font-serif tracking-wide" id="exerciseMuscleTitle">Pecho</h4>
<p class="text-xs text-slate-300 mt-1 leading-relaxed" id="exerciseNameDesc">
              Flexiones de pecho clásicas o diamantadas: 3 series de 12 a 15 repeticiones para reactivar la circulación.
            </p>
<div class="flex items-center gap-3 mt-3">
<span class="text-[11px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700">
<i class="fa-solid fa-stopwatch text-rolex-gold mr-1"></i> 3 Series
              </span>
<span class="text-[11px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700">
<i class="fa-solid fa-heart-pulse text-rose-400 mr-1"></i> Intensidad Media
              </span>
</div>
</div>
</div>
