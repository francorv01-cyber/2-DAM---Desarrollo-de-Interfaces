          clearInterval(state.musicInterval);
          playMusicLoop();
        }
      }
    }

    /* =========================================================================
       9. RELOJ EN TIEMPO REAL & COMPLICACIÓN DAY-DATE COMPLETA (DÍA Y FECHADOR 3H)
       ========================================================================= */
    const daysSpanish = ['DOMINGO', 'LUNES', 'MARTES', 'MIÉRCOLES', 'JUEVES', 'VIERNES', 'SÁBADO'];
    const monthsSpanish = [
      'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
      'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
    ];

    function updateRealTimeClock() {
      const now = new Date();
      const dayOfWeekIndex = now.getDay();
      const dayName = daysSpanish[dayOfWeekIndex];
      const dayNumber = now.getDate();
      const monthName = monthsSpanish[now.getMonth()];
      const year = now.getFullYear();

      // Formato HH:MM:SS
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const seconds = String(now.getSeconds()).padStart(2, '0');
      const timeString = `${hours}:${minutes}:${seconds}`;

      // Inyectar en complicación de cabecera
      document.getElementById('liveDayName').textContent = dayName;
      document.getElementById('liveFullDate').textContent = `${dayNumber} de ${monthName}, ${year}`;
      document.getElementById('liveTime').textContent = timeString;

      // Inyectar en ventanilla de día superior del dial del Rolex Day-Date
      document.getElementById('dialDayWindow').textContent = dayName;

      // Inyectar en la lupa Cíclope a las 3 en punto (3h Date aperture)
      document.getElementById('dialDateNumber').textContent = dayNumber;
    }

    /* =========================================================================
       10. CARGA DE RUTINA DEL DÍA & FRASES MOTIVACIONALES
       ========================================================================= */
    function loadDayFitnessRoutine() {
      const dayIndex = new Date().getDay();
      const routine = fitnessRoutines[dayIndex];
      
      if (routine) {
        document.getElementById('fitnessDayTag').textContent = routine.day;
        document.getElementById('exerciseMuscleTitle').textContent = routine.muscle;
        document.getElementById('exerciseNameDesc').textContent = routine.desc;
        document.getElementById('exerciseSvgContainer').innerHTML = `
          ${routine.svg}
          <span class="text-[9px] font-mono tracking-wider text-slate-300 font-bold uppercase mt-1">${routine.muscle}</span>
        `;
      }

      const randomQuote = rockyQuotes[Math.floor(Math.random() * rockyQuotes.length)];
      document.getElementById('motivationalQuoteText').textContent = `"${randomQuote.quote}"`;
      document.getElementById('motivationalQuoteAuthor').textContent = `— ${randomQuote.author}`;
    }

    /* =========================================================================
       11. MOTOR DEL TEMPORIZADOR POMODORO (CRONÓMETRO)
       ========================================================================= */
    function formatTime(totalSeconds) {
      const mins = Math.floor(totalSeconds / 60);
      const secs = totalSeconds % 60;
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function updateTimerUI() {
      const formatted = formatTime(state.secondsLeft);
      document.getElementById('dialTimerDisplay').textContent = formatted;
      document.title = `${formatted} — FokusMove Rolex Chrono`;

      // Calcular trazo del círculo SVG (circunferencia = 2 * PI * 158 ≈ 992)
      const circumference = 992;
      const progressFraction = (state.totalDurationSeconds - state.secondsLeft) / state.totalDurationSeconds;
      const offset = circumference - (progressFraction * circumference);
      const circle = document.getElementById('timerProgressCircle');
      if (circle) {
        circle.style.strokeDashoffset = offset;
      }
    }

    function toggleTimer() {
      if (state.isRunning) {
        pauseTimer();
      } else {
        startTimer();
      }
    }

    function startTimer() {
      getAudioContext();
      state.isRunning = true;
      
      document.getElementById('btnTextPlayPause').textContent = 'PAUSAR';
      document.getElementById('btnIconPlayPause').className = 'fa-solid fa-pause text-xs';
      document.getElementById('dialTimerDisplay').classList.add('ticking-glow');

      // Si entramos a descanso y no hay música sonando, activar música motivacional
      if (state.currentMode !== 'work' && !state.musicPlaying) {
        toggleRockyMusic();
      }

      state.timerInterval = setInterval(() => {
        if (state.secondsLeft > 0) {
          state.secondsLeft--;
          updateTimerUI();
          playMechanicalTick();

          if (state.currentMode === 'work' && state.secondsLeft % 60 === 0) {
            state.dailyMinutesFocused++;
            document.getElementById('statMinutesFocused').textContent = `${state.dailyMinutesFocused} min`;
          }

        } else {
          timerCompleted();
        }
      }, 1000);
    }

    function pauseTimer() {
      clearInterval(state.timerInterval);
      state.isRunning = false;
      document.getElementById('btnTextPlayPause').textContent = 'REANUDAR';
      document.getElementById('btnIconPlayPause').className = 'fa-solid fa-play text-xs';
      document.getElementById('dialTimerDisplay').classList.remove('ticking-glow');
    }

    function resetTimer() {
      pauseTimer();
      state.secondsLeft = state.durations[state.currentMode] * 60;
      state.totalDurationSeconds = state.secondsLeft;
      document.getElementById('btnTextPlayPause').textContent = `INICIAR ${state.currentMode === 'work' ? 'ENFOQUE' : 'DESCANSO'}`;
      document.getElementById('btnIconPlayPause').className = 'fa-solid fa-play text-xs';
      updateTimerUI();
    }

    function timerCompleted() {
      pauseTimer();
      playFinishGong();

      if (state.currentMode === 'work') {
        state.completedToday++;
        document.getElementById('statSessionsToday').textContent = state.completedToday;
        document.getElementById('pomodoroGoalProgress').textContent = `${state.completedToday} / 4`;

        if (state.completedToday % 4 === 0) {
          alert('¡Excelente trabajo! Has completado 4 bloques de enfoque. Disfruta un Descanso Largo de 15 minutos.');
          setTimerMode('long');
        } else {
          alert('¡Sesión de Enfoque culminada! Momento del Descanso Corto. Revisa tu rutina fitness.');
          setTimerMode('short');
        }
      } else {
        alert('¡Descanso completado! Preparado para el siguiente asalto de trabajo enfocado.');
        state.cycleCount++;
        document.getElementById('cycleCountDisplay').textContent = `Ciclo #${state.cycleCount}`;
        setTimerMode('work');
      }
    }

    function skipToNextPhase() {
      if (confirm('¿Deseas saltar a la siguiente fase?')) {
        if (state.currentMode === 'work') {
          setTimerMode('short');
        } else {
          setTimerMode('work');
        }
      }
    }

    function setTimerMode(mode) {
      state.currentMode = mode;
      pauseTimer();
      
      state.secondsLeft = state.durations[mode] * 60;
      state.totalDurationSeconds = state.secondsLeft;

      // Actualizar botones de modo
      const btnWork = document.getElementById('btnModeWork');
      const btnShort = document.getElementById('btnModeShort');
      const btnLong = document.getElementById('btnModeLong');
      const badge = document.getElementById('currentStatusBadge');

      const activeClass = "bg-gradient-to-r from-rolex-gold to-yellow-600 text-slate-950 shadow-md font-bold";
      const inactiveClass = "text-slate-300 hover:text-white";

      btnWork.className = `flex-1 py-2 px-3 rounded-full text-xs font-semibold tracking-wider transition-all duration-300 ${mode === 'work' ? activeClass : inactiveClass}`;
      btnShort.className = `flex-1 py-2 px-3 rounded-full text-xs font-semibold tracking-wider transition-all duration-300 ${mode === 'short' ? activeClass : inactiveClass}`;
      btnLong.className = `flex-1 py-2 px-3 rounded-full text-xs font-semibold tracking-wider transition-all duration-300 ${mode === 'long' ? activeClass : inactiveClass}`;

      if (mode === 'work') {
        badge.textContent = "SESIÓN ENFOQUE";
        badge.className = "text-[10px] tracking-widest font-semibold px-2.5 py-0.5 rounded-full bg-slate-900 text-rolex-gold border border-rolex-gold/40 uppercase shadow-sm";
        document.getElementById('btnTextPlayPause').textContent = "INICIAR ENFOQUE";
      } else if (mode === 'short') {
        badge.textContent = "DESCANSO CORTO";
        badge.className = "text-[10px] tracking-widest font-semibold px-2.5 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-500/40 uppercase shadow-sm";
        document.getElementById('btnTextPlayPause').textContent = "INICIAR DESCANSO";
      } else {
        badge.textContent = "DESCANSO LARGO";
        badge.className = "text-[10px] tracking-widest font-semibold px-2.5 py-0.5 rounded-full bg-blue-950 text-blue-300 border border-blue-500/40 uppercase shadow-sm";
        document.getElementById('btnTextPlayPause').textContent = "INICIAR DESCANSO";
      }

      // Actualizar paneles contextuales de forma inteligente
      updateContextualPanels(mode);
      updateTimerUI();
    }

    /* =========================================================================
       12. GUARDAR AJUSTES MANUALES DE DURACIÓN
       ========================================================================= */
    function saveTimerSettings() {
      const workVal = parseInt(document.getElementById('inputWorkTime').value, 10);
      const shortVal = parseInt(document.getElementById('inputShortTime').value, 10);
      const longVal = parseInt(document.getElementById('inputLongTime').value, 10);

      if (workVal > 0) state.durations.work = workVal;
      if (shortVal > 0) state.durations.short = shortVal;
      if (longVal > 0) state.durations.long = longVal;

      document.getElementById('configModal').classList.add('hidden');
      resetTimer();
    }

    /* =========================================================================
       13. AGENDA DE TAREAS SEMANAL (TO-DO LIST)
       ========================================================================= */
    function renderTasks() {
      const list = document.getElementById('taskList');
      list.innerHTML = '';

      let pending = 0;

      state.tasks.forEach(task => {
        if (!task.done) pending++;

        const li = document.createElement('li');
        li.className = `flex items-center justify-between p-2.5 rounded-xl border transition ${
          task.done ? 'bg-slate-900/40 border-slate-800 opacity-60' : 'bg-slate-900/90 border-slate-700/80'
        }`;

        li.innerHTML = `
          <div class="flex items-center gap-2.5 flex-1 min-w-0 mr-2">
            <input type="checkbox" ${task.done ? 'checked' : ''} onchange="toggleTaskDone(${task.id})" class="w-4 h-4 accent-rolex-gold rounded cursor-pointer">
            <span class="text-xs truncate ${task.done ? 'line-through text-slate-500' : 'text-slate-200'}">${escapeHtml(task.text)}</span>
          </div>
          <button onclick="deleteTask(${task.id})" class="text-slate-500 hover:text-rose-400 p-1 transition" title="Eliminar">
            <i class="fa-solid fa-trash-can text-xs"></i>
          </button>
        `;
        list.appendChild(li);
      });

      document.getElementById('todoPendingCounter').textContent = `${pending} Pendientes`;
    }

    function handleAddTask(e) {
      e.preventDefault();
      const input = document.getElementById('newTaskInput');
      const text = input.value.trim();
      if (!text) return;

      state.tasks.unshift({
        id: Date.now(),
        text: text,
        done: false
      });

      input.value = '';
      renderTasks();
    }

    function toggleTaskDone(id) {
      const task = state.tasks.find(t => t.id === id);
      if (task) {
        task.done = !task.done;
        renderTasks();
      }
    }

    function deleteTask(id) {
      state.tasks = state.tasks.filter(t => t.id !== id);
      renderTasks();
    }

    function escapeHtml(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
      );
    }

    /* =========================================================================
       14. EVENTOS Y CONTROL DE SONIDO DE TICTAC
       ========================================================================= */
    document.getElementById('toggleTickingSoundBtn').addEventListener('click', () => {
      state.soundEnabled = !state.soundEnabled;
      const icon = document.getElementById('soundIcon');
      const label = document.getElementById('soundLabel');
      if (state.soundEnabled) {
        icon.className = 'fa-solid fa-volume-high text-rolex-gold';
        label.textContent = 'Tictac: ON';
      } else {
        icon.className = 'fa-solid fa-volume-xmark text-slate-500';
        label.textContent = 'Tictac: OFF';
      }
    });

    /* =========================================================================
       15. INICIALIZACIÓN AL CARGAR LA PÁGINA
       ========================================================================= */
    window.addEventListener('DOMContentLoaded', () => {
      updateRealTimeClock();
      setInterval(updateRealTimeClock, 1000);
      loadDayFitnessRoutine();
      updateTimerUI();
      renderTasks();
      // Inicializar visibilidad contextual para modo "work"
      updateContextualPanels(state.currentMode);
    });
  </script>
</body></html>
